# ============================================================
# Deadline Defenders - Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# ── SERVER CONFIGURATION ────────────────────────────────────
PORT=3000
NODE_ENV=production
APP_URL=http://localhost:3000
SESSION_SECRET=your_super_random_session_secret_key_change_me_2026

# ── DATABASE CONFIGURATION (Local or Cloud MySQL) ───────────
# For Local XAMPP MySQL:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=deadline_defenders
DB_SSL=false

# For Free Cloud MySQL (e.g. Aiven.io / TiDB Cloud):
# DB_HOST=your-mysql-host.aivencloud.com
# DB_PORT=12345
# DB_USER=avnadmin
# DB_PASSWORD=your_cloud_password
# DB_NAME=defaultdb
# DB_SSL=true

# ── WEB PUSH (VAPID KEYS) ───────────────────────────────────
# Generate your own keys using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BFs84GA9gHYEAhB2ehAKYu-45kQQu-ddolDbTkHBn_NN7Yic7jT9rUj-2fgyhboeq37g7TsGfFwzjA_4VX0mNMY
VAPID_PRIVATE_KEY=1MhGDGSRASuEW9P-7OWnzSWrKbXJi36bPSe0VxKFxJc
VAPID_SUBJECT=mailto:your_email@gmail.com

# ── EMAIL NOTIFICATIONS (GMAIL SMTP - Optional) ─────────────
# Generate an App Password in Google Account > Security > 2-Step Verification > App passwords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_char_app_password

